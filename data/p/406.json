.vn/hsk/brandbrandsimple-logo1763966500.jpg"},"market_price":420000,"sale":252000,"price":138000,"quantity":0,"bought_count":0,"deal":{"percent":93,"qty":93,"expired":1795291199,"remain":3700},"rating":{"avg":4.9,"total":22},"comment_total":118,"now_free":false,"announce":"","gallery":["https://media.hcdn.vn/catalog/product/f/a/facebook-dynamic-combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-200ml-1764921098.jpg","https://media.hcdn.vn/catalog/product/g/o/google-shopping-combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-200ml-1753347840.jpg","https://media.hcdn.vn/catalog/product/t/e/tem-phu-combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-200ml-1753347851.jpg","https://media.hcdn.vn/hsk/brand/certificate/Certificate-simple1794882273.jpg","https://media.hcdn.vn/catalog/product/d/o/doi-mau-nuoc-tay-trang-simple-danh-cho-da-nhay-cam-200ml-1753347878.jpg","https://media.hcdn.vn/catalog/product/t/h/thanh-phan-combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-200ml-1753347840.jpg","https://media.hcdn.vn/catalog/product/d/o/do-an-toan-combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-200ml-1753347840.jpg","https://media.hcdn.vn/catalog/product/h/d/hdsd-combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-200ml-1753347840.jpg"],"cats":[{"id":3,"name":"Sức Khỏe - Làm Đẹp"},{"id":4,"name":"Chăm Sóc Da Mặt"},{"id":1855,"name":"Làm Sạch Da"},{"id":48,"name":"Tẩy Trang Mặt"}],"promo":"","promos":[],"badge":null,"desc":"<div ><p><strong>Nước Tẩy Trang Simple Làm Sạch Trang Điểm Và Cấp Ẩm </strong>là sản phẩm <a href=\"https://hasaki.vn/danh-muc/tay-trang-mat-c48.html\" target=\"_blank\">tẩy trang mặt</a> đến từ <a href=\"https://hasaki.vn/thuong-hieu/simple.html\" target=\"_blank\">thương hiệu Simple</a> xuất xứ Anh Quốc. Công thức cải tiến với công nghệ làm sạch <strong>Micellar</strong> chứa hàng triệu bong bóng Micelles thông minh giúp loại bỏ lớp trang điểm và bụi bẩn hiệu quả, làm thông thoáng lỗ chân lông, mang lại cảm giác tươi mát cho da sau khi sử dụng, đồng thời cấp ẩm lên đến 4 giờ mà không để lại dư lượng thừa trên da.</p>\n<p> </p>\n<p style=\"text-align: center;\"><img title=\"Mua Ngay Nước Tẩy Trang Simple Làm Sạch Trang Điểm Vượt Trội\" src=\"https://media.hcdn.vn/wysiwyg/Chau/combo-2-nuoc-tay-trang-simple-lam-sach-trang-diem-vuot-troi-400ml-doi-mau.jpg\" alt=\"Nước Tẩy Trang Simple Làm Sạch Trang Điểm Vượt Trội\" width=\"800\" height=\"800\" /></p>\n<p> </p>\n<p style=\"text-align: left;\"><strong>Nước Tẩy Trang Simple Micellar Cleansing Water</strong><span> được mệnh danh là \"best seller\" của Simple kể từ khi ra mắt, được rất rất nhiều tín đồ làm đẹp ưa thích nhờ vào khả năng làm sạch, loại bỏ mọi bụi bẩn bã nhờn cùng lớp makeup mà không gây kích ứng da, kể cả những vùng da nhạy cảm như mắt và môi. Mang đến cho bạn làn da tươi mới, thông thoáng lỗ chân lông và tràn đầy sức sống.</span></p>\n<p style=\"text-align: left;\"><span><br /></span></p>\n<p style=\"text-align: center;\"><span><img title=\"Mua Nước Tẩy Trang Simple Làm Sạch Trang Điểm Vượt Trội Tại Hasaki\" src=\"https://media.hcdn.vn/wysiwyg/Chau/nuoc-tay-trang-simple-lam-sach-trang-diem-vuot-troi-1.jpg\" alt=\"Nước Tẩy Trang Simple Làm Sạch Trang Điểm Vượt Trội Tại Hasaki\" width=\"800\" height=\"800\" /></span></p>\n<p style=\"text-align: left;\"><span><br /></span></p>\n<p style=\"text-align: left;\"><strong>Nước Tẩy Trang Simple Micellar Cleansing Water</strong> chính hãng<strong> </strong>hiện<strong> </strong>đã có mặt tại <a href=\"https://hasaki.vn/\" target=\"_blank\">Hasaki</a> với 4 quy cách đóng gói cho bạn lựa chọn:</p>\n<ul>\n<li>\n<p><strong>200ml </strong></p>\n</li>\n<li>\n<p><strong>400ml  </strong></p>\n</li>\n<li>\n<p><strong>Combo 2x400ml </strong></p>\n</li>\n<li>\n<p><strong>Combo 200ml + 400ml  </strong></p>\n</li>\n</ul>\n<h2 style=\"font-size: 20px;font-weight: bolder;\">Nước Tẩy Trang Simple Micellar Cleansing Water phù hợp với loại da nào?</h2>\n<ul>\n<li>\n<p>Sản phẩm phù hợp cho mọi loại da, đặc biệt là da nhạy cảm.</p>\n</li>\n</ul>\n<h2 style=\"font-size: 20px;font-weight: bolder;\">Đối tượng sử dụng Nước Tẩy Trang Simple Micellar Cleansing Water:</h2>\n<ul>\n<li>\n<p><a href=\"https://hasaki.vn/danh-muc/nhay-cam-kich-ung-c1885.html\" target=\"_blank\">Da nhạy cảm - kích ứng</a>.</p>\n</li>\n<li>\n<p><a href=\"https://hasaki.vn/danh-muc/thieu-am-thieu-nuoc-c1883.html\" target=\"_blank\">Da thiếu ẩm, thiếu nước</a>.</p>\n</li>\n</ul>\n<h2 style=\"font-size: 20px;font-weight: bolder;\">Ưu thế nổi bật của Nước Tẩy Trang Simple Micellar Cleansing Water:</h2>\n<ul>\n<li>\n<p><span><strong> Nước tẩy trang Simple</strong> loại bỏ đến 99% lớp trang điểm* nhờ các hạt micelle siêu nhỏ gồm một cực ưa dầu hút mọi bụi bẩn, cặn trang điểm và một cực ưa nước giúp hòa tan, cuốn trôi mọi tạp chất.</span></p>\n</li>\n<li>\n<p><span><strong>Bổ sung</strong> <strong>Vitamin B3</strong> giúp đem lại cảm giác thoáng mịn ngay khi sử dụng cho da sau tẩy trang.</span></p>\n</li>\n<li>\n<p><span>Không chứa 2000 hóa chất có hại, không cồn, hương liệu, paraben gây căng da, cay mắt.</span></p>\n</li>\n</ul>\n<p><em>*Dựa trên kết quả kiểm nghiệm với mascara không trôi</em></p>\n<h2 style=\"font-size: 20px;font-weight: bolder;\">Độ lành tính:</h2>\n<ul>\n<li>\n<p>Không chứa 2000 hoá chất có hại cho da.</p>\n</li>\n<li>\n<p>Độ pH=5 lành tính cho mọi loại da.</p>\n</li>\n<li>\n<p>100% không cồn, không gây khô da/ kích ứng da.</p>\n</li>\n<li>\n<p>Đã được <span>kiểm nghiệm da liễu và được xác nhận dịu nhẹ cho da, kể cả da nhạy cảm.</span></p>\n</li>\n</ul>\n<p> </p>\n<p style=\"text-align: center;\"><img title=\"Mua Ngay Nước Tẩy Trang Simple Làm Sạch Trang Điểm Vượt Trội Tại Hasaki\" src=\"https://media.hcdn.vn/wysiwyg/Chau/nuoc-tay-trang-simple-lam-sach-trang-diem-vuot-troi-2.jpg\" alt=\"Nước Tẩy Trang Simple Làm Sạch Trang Điểm Vượt Trội Có Tại Hasaki\" width=\"800\" height=\"800\" /></p>\n<p> </p>\n<h2 style=\"font-size: 20px;font-weight: bolder;\">Hướng dẫn bảo quản Nước Tẩy Trang Simple Micellar Cleansing Water:</h2>\n<ul>\n<li>\n<p><span>Tránh tiếp xúc với mắt. Nếu tiếp xúc với mắt, rửa ngay bằng nước sạch.</span></p>\n</li>\n<li>\n<p><span>Để xa tầm tay trẻ em.</span></p>\n</li>\n<li>\n<p><span>Tránh nhiệt độ cao và ánh nắng trực tiếp.</span></p>\n</li>\n<li>\n<p><span>Đóng nắp sau khi sử dụng.</span></p>\n</li>\n</ul>\n<h2 style=\"font-size: 20px;font-weight: bolder;\">Lưu ý:</h2>\n<ul>\n<li>\n<p><strong>Hạn sử dụng:</strong> 3 năm kể từ ngày sản xuất.</p>\n</li>\n<li>\n<p>Hiện tại Hasaki đang bán song song 2 mẫu cũ và mới ở cả 2 dung tích 200ml, 400ml.</p>\n</li>\n</ul></div><div class=\"box-warning width_common\" style=\"border: thin solid #b1ead0;background-color: #e5fbf1;padding: 10px; margin: 15px 0;\">\n            <p style=\"font-weight: bold;\">Làm sao để phân biệt hàng có trộn hay không?</p>\n            <ul>\n                <li>Hàng trộn sẽ không thể <strong>xuất hoá đơn GTGT (VAT) 100%</strong> được do có hàng không nguồn gốc trong đó.</li>\n                <li>Tại Hasaki, 100% hàng bán ra sẽ được <strong>xuất hoá đơn GTGT</strong> cho dù khách hàng có lấy hay không. Nếu có nhu cầu lấy hoá đơn GTGT, quý khách vui lòng cung cấp thông tin xuất hóa đơn trong vòng 30 phút sau khi nhận hàng và trước 22h30 cùng ngày. 30 phút sau khi giao hàng thành công, hệ thống Hasaki sẽ tự động xuất hết hoá đơn cho những hàng hoá mà khách hàng không đăng kí lấy hoá đơn.</li>\n                <li>Do <strong>100%</strong> hàng hóa bán ra đều được xuất hết hóa đơn GTGT trong ngày nên đảm bảo 100% hàng tại Hasaki là hàng chính hãng có nguồn gốc rõ ràng.</li>\n            </ul>\n        </div>","spec":[["Thương Hiệu","Simple"],["Xuất xứ thương hiệu","Anh"],["Nơi sản xuất","Poland"],["Loại da","Da nhạy cảm"],["Dung Tích","2x200ml"]],"ingr":"<div ><p><p><strong>Thành phần chính: </strong></p>\n<ul>\n<li>\n<p><strong>Công nghệ làm sạch Micellar:</strong> với hàng triệu phân tử Micelles thông minh giúp nhẹ nhàng làm sạch bụi bẩn, dầu thừa trên da, lớp trang điểm kể cả sản phẩm chống thấm nước.</p>\n</li>\n<li>\n<p><strong>Hoa cúc La Mã Chamomile</strong> giúp làm dịu và dưỡng ẩm da hiệu quả.</p>\n</li>\n<li>\n<p><strong>Nước tinh khiết được lọc 3 lần: </strong>rất dịu nhẹ cho làn da nhạy cảm, hỗ trợ làm dịu da.</p>\n</li>\n<li>\n<p><strong>Vitamin B3 và Vitamin C:</strong> có khả năng chống oxy hóa, làm dịu da sưng và dưỡng da sáng mịn màng.</p>\n</li>\n</ul>\n<p><strong>Thành phần chi tiết:</strong></p>\n<p>Aqua, Hexylene Glycol, Glycerin, PEG-6 Caprylic/Capric Glycerides, Phenoxyethanol, Cetrimonium Chloride, Tetrasodium EDTA,Propylene Glycol, Citric Acid, Cetylpyridinium Chloride, Sodium Chloride, Niacinamide, Sodium Ascorbyl, Phosphate, Potassium chloride, Panthenol.</p></p></div>","guide":"<div ><ul>\n<li>\n<p><span data-spm-anchor-id=\"a2o4n.pdp_revamp.product_detail.i7.1d479ddcQpMXhB\">Thấm nước tẩy trang vào bông cotton và nhẹ nhàng lau khắp mặt, hạn chế chà xát da, tránh dính vào mắt, nếu dính vào mắt cần rửa kỹ lại bằng nước.</span></p>\n</li>\n<li>\n<p>Sau khi tẩy trang, dùng sữa rửa mặt và toner để làm sạch da tốt và dùng tiếp các bước tiếp theo của chu trình dưỡng da.</p>\n</li>\n</ul></div>","reviews":[{"content":"pass 60k 200ml chưa khuôi cho ai ở Cần Thơ nt mình 0933193938","user":"Phan Kiều","star":5,"at":1750747955,"reply":"Hasaki xin chào! Hasaki cảm ơn Phan Kiều đã dành thời gian đánh giá. Sự hài lòng của khách hàng là động lực to lớn để Hasaki ngày càng phát triển hơn nữa về chất lượng dịch vụ. Cảm ơn bạn đã tin tưởng và mua sắm tại Hasaki!","imgs":["https://media.hcdn.vn/rating/17507479550250.jpg"]},{"content":"thấy vài người review ẻm ko sạch nhưng mình dùng thấy cũng sạch cỡ 93% dù mình da dầu. miếng phải là ẻm còn trái là garnier nhưng lên hình ko rõ màu lắm","user":"HỒ NGUYỄN XUÂN AN","star":4,"at":1694951893,"reply":"","imgs":["https://media.hcdn.vn/rating/16949518938630.jpg"]},{"content":"Tẩy trang nhẹ nhàng, ko gây kích ứng, tẩy đc lớp kcn thui nha mng. Mình dùng vào buổi sáng là chính, hôm nào makeup thì p dùng loại có dầu."