{
  "name": "hasaki-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "1:1 storefront clone of hasaki.vn — static site + Cloudflare Pages Functions + /bp checkout connector",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "parse": "node scripts/parse.mjs",
    "fetch": "node scripts/fetch-inventory.mjs",
    "fetch:detail": "node scripts/fetch-detail.mjs",
    "fetch:policy": "node scripts/fetch-policy-render.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
