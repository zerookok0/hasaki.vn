/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://annangourmet.makeup wss://annangourmet.makeup https://connect.facebook.net https://www.facebook.com; frame-src 'self' https://annangourmet.makeup https://www.facebook.com; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: payment=(self), clipboard-write=(self)
  X-DNS-Prefetch-Control: on

/checkout
  Cache-Control: no-store
/checkout/
  Cache-Control: no-store
/order/*
  Cache-Control: no-store
/api/*
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
/bp/*
  Cache-Control: public, max-age=300
/bp/config.json
  Cache-Control: no-cache
/data/index.json
  Cache-Control: public, max-age=600
/data/*
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=604800
